# Lab-only credentials. Every service binds to 127.0.0.1. Change these before exposing anything.
# `make env` copies this file to .env (gitignored) if .env does not exist yet.
LAKE_S3_ACCESS_KEY=realtime
LAKE_S3_SECRET_KEY=realtime-lab-change-me
LAKE_S3_REGION=us-east-1
LAKE_WAREHOUSE=s3://warehouse/

# Host ports (all on 127.0.0.1), in a 2xxxx range so this lab can run next to the lakehouse lab.
PORT_KAFKA=29092
PORT_KAFKA_UI=28080
PORT_S3_API=29000
PORT_S3_CONSOLE=29001
PORT_CATALOG=28181
PORT_SPARK_UI=24040
PORT_SPARK_HISTORY=28090

SPARK_DRIVER_MEMORY=3g
