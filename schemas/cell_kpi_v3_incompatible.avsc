{
  "type": "record",
  "name": "CellKpi",
  "namespace": "io.masterfabric.telco",
  "doc": "Deliberately incompatible change used by the registry demo: a required field without a default.",
  "fields": [
    {
      "name": "v",
      "type": "int",
      "doc": "payload contract version carried in the record"
    },
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_ts",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "end of the reporting interval, UTC"
    },
    {
      "name": "cell_id",
      "type": "string"
    },
    {
      "name": "site_id",
      "type": "string"
    },
    {
      "name": "city",
      "type": "string"
    },
    {
      "name": "rat",
      "type": "string",
      "doc": "LTE or NR (a plain string: Avro cannot resolve an enum writer to a string reader, which Flink derives from the table DDL)"
    },
    {
      "name": "interval_s",
      "type": "int"
    },
    {
      "name": "active_users",
      "type": "double"
    },
    {
      "name": "prb_util_pct",
      "type": "double"
    },
    {
      "name": "dl_throughput_mbps",
      "type": "double"
    },
    {
      "name": "ul_sinr_db",
      "type": "double"
    },
    {
      "name": "latency_ms",
      "type": "double"
    },
    {
      "name": "rrc_attempts",
      "type": "long"
    },
    {
      "name": "rrc_success",
      "type": "long"
    },
    {
      "name": "erab_drops",
      "type": "long"
    },
    {
      "name": "availability_pct",
      "type": "double"
    },
    {
      "name": "energy_kwh",
      "type": [
        "null",
        "double"
      ],
      "default": null
    },
    {
      "name": "vendor",
      "type": "string",
      "doc": "required, no default: a v3 reader cannot read v1/v2 data"
    }
  ]
}
